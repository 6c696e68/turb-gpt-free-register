# Copy to .env and fill values. Never commit .env
#   cp .env.example .env

# Mọi cấu hình WebUI sửa được đều dùng .env ghi đè mặc định config/*.py.

# ---- Uỷ quyền WebUI ----
# Mã uỷ quyền đăng nhập WebUI; chỉ lưu trong .env, tránh lộ trên dòng lệnh tiến trình
WEBUI_AUTH_CODE="123456"
# Tuỳ chọn: khoá ký Session Cookie; để trống thì suy từ mã uỷ quyền cố định, đổi mã làm phiên hiện có hết hiệu lực
WEBUI_SESSION_SECRET="123456"


# ---- Công tắc tính năng ----
# Bật Codex OAuth: sau đăng ký thành công tự chạy uỷ quyền Codex (session mới + nhận OTP SMS), ghi codex-email.json
ENABLE_CODEX_AUTO="False"

# ---- Cách đăng ký ----
# Driver đăng ký: protocol=thuần giao thức; roxy=RoxyBrowser; cloak=CloakBrowser; browser_use=Browser Use Cloud+Playwright
REGISTRATION_DRIVER="roxy"

# ---- CloakBrowser ----
# Cloak headless: True=chạy headless; False=hiện cửa sổ trình duyệt
CLOAK_HEADLESS="False"
# Hành vi người Cloak: bật humanize chuột/bàn phím/cuộn của CloakBrowser
CLOAK_HUMANIZE="True"
# Cloak định vị theo đầu ra: tự khớp múi giờ/ngôn ngữ/WebRTC IP theo IP đầu ra; hỗ trợ proxy tường minh, proxy hệ thống/VPN
CLOAK_GEOIP="True"
# Ngôn ngữ Cloak: để trống = tự động; Nhật điền ja-JP, Mỹ en-US
CLOAK_LOCALE=""
# Múi giờ Cloak: để trống = tự động; Nhật điền Asia/Tokyo, Mỹ America/Los_Angeles
CLOAK_TIMEZONE=""
# Cloak dùng proxy: truyền proxy của project hoặc proxy rút từ kho proxy sang CloakBrowser
CLOAK_USE_PROXY="False"
# Cloak License: Pro license; để trống dùng binary miễn phí
CLOAK_LICENSE_KEY=""
# Cloak fingerprint seed: để trống mỗi lần ngẫu nhiên; giá trị cố định giữ cùng fingerprint
CLOAK_FINGERPRINT_SEED=""
# Thư mục user Cloak: để trống dùng context tạm; điền path thì giữ cookies/cache
CLOAK_USER_DATA_DIR=""
# Timeout Cloak: thời gian chờ trang và phần tử, giây
CLOAK_SELENIUM_TIMEOUT="90"
# Giữ trình duyệt Cloak: bật khi debug, không tự đóng sau tác vụ
CLOAK_KEEP_BROWSER_OPEN="False"

# ---- Browser Use ----
# Browser Use API Key: lưu trong .env (BROWSER_USE_API_KEY), không ghi ngược config/*.py
BROWSER_USE_API_KEY=""
# Mã quốc gia proxy: mã 2 ký tự, ví dụ jp/us/sg; dùng với residential proxy tích hợp Browser Use
BROWSER_USE_PROXY_COUNTRY_CODE="jp"
# Dùng proxy tích hợp: True=tham số kết nối có proxyCountryCode; False=không ép tham số proxy quốc gia
BROWSER_USE_USE_PROXY="True"
# Profile ID: tuỳ chọn. Điền thì tái dùng cookies/localStorage của profile Browser Use; hàng loạt nên để trống
BROWSER_USE_PROFILE_ID=""
# Địa chỉ CDP: mặc định wss://connect.browser-use.com
BROWSER_USE_CDP_BASE="wss://connect.browser-use.com"
# Timeout thao tác (giây): timeout thao tác mặc định Playwright
BROWSER_USE_TIMEOUT="90"
# Chế độ nhanh: giảm chờ thêm và delay humanize của Browser Use; nên bật, tắt khi lần lỗi
BROWSER_USE_FAST_MODE="True"
# Log thời gian: in thời gian từng pha Browser Use: kết nối, mở trang, email, OTP, điện thoại, callback
BROWSER_USE_LOG_TIMING="True"
# Giữ phiên từ xa: khi debug có thể không chủ động browser.close(); mặc định False
BROWSER_USE_KEEP_BROWSER_OPEN="False"
# URL bắt đầu: mặc định https://chatgpt.com/auth/login
BROWSER_USE_START_URL="https://chatgpt.com/auth/login"

# ---- Skyvern ----
# Skyvern API Key: dùng để tạo Browser Session
SKYVERN_API_KEY=""
# Địa chỉ API: mặc định https://api.skyvern.com
SKYVERN_API_BASE="https://api.skyvern.com"
# Timeout Browser Session (phút)
SKYVERN_BROWSER_SESSION_TIMEOUT="60"
# Tuỳ chọn: tái dùng Skyvern browser profile
SKYVERN_BROWSER_PROFILE_ID=""
# Tuỳ chọn: vùng proxy Skyvern; jp tự chuyển thành RESIDENTIAL_JP
SKYVERN_PROXY_LOCATION=""
# Loại trình duyệt: mặc định stealth-chromium; có thể msedge/chrome/stealth-chromium
SKYVERN_BROWSER_TYPE="stealth-chromium"
# Có bật chặn quảng cáo không
SKYVERN_AD_BLOCKER="True"
# Có lưu browser profile khi kết thúc không
SKYVERN_GENERATE_BROWSER_PROFILE="False"
# Giữ trình duyệt khi debug
SKYVERN_KEEP_BROWSER_OPEN="False"
# URL bắt đầu
SKYVERN_START_URL="https://chatgpt.com/auth/login"

# ---- RoxyBrowser ----
# Địa chỉ Roxy API: mặc định http://127.0.0.1:50000; phải bật trong cấu hình API ứng dụng Roxy
ROXY_API_BASE="http://127.0.0.1:50000"
# Roxy API Key: lưu trong .env (ROXY_API_TOKEN), không ghi ngược config/*.py
ROXY_API_TOKEN=""
# Roxy profile ID: Profile ID môi trường trình duyệt Roxy cần mở; để trống thì thử tạo môi trường tạm
ROXY_PROFILE_ID=""
# Roxy workspace ID: bắt buộc khi tạo một tài khoản một profile; gửi làm workspaceId cho API tạo Profile
ROXY_WORKSPACE_ID="10910593635479552"
# Roxy project ID: lấy project_details.projectId từ /browser/workspace; gửi làm projectId khi tạo Profile
ROXY_PROJECT_ID="10910593710977024"
# API lấy team: mặc định /browser/workspace; khi bấm lấy team/dự án thử path này trước, rồi các path tương thích thường gặp
ROXY_WORKSPACE_LIST_PATH="/browser/workspace"
# Path API mở: mặc định /browser/open; bản Roxy khác thì chỉnh ở đây
ROXY_OPEN_PATH="/browser/open"
# Khoảng cách tạo môi trường: khoảng tối thiểu giữa các request /browser/create khi đa luồng, mặc định 1.5 giây; 0 = tắt
ROXY_CREATE_INTERVAL="1.5"
# Mở cửa sổ headless: khi mở môi trường Roxy truyền headless cho /browser/open; False=hiện cửa sổ, True=headless
ROXY_OPEN_HEADLESS="False"
# Path API đóng: mặc định /browser/close
ROXY_CLOSE_PATH="/browser/close"
# Giữ trình duyệt: bật khi debug, không tự đóng môi trường Roxy sau tác vụ
ROXY_CREATE_RETRIES="3"
ROXY_CREATE_RETRY_DELAY="3"
ROXY_KEEP_BROWSER_OPEN="False"
# Cache tài nguyên tĩnh local xuyên Profile của Roxy; tự bật khi BROWSER_DATA_SAVER_MODE bật
ROXY_LOCAL_ASSET_CACHE_ENABLED="False"
ROXY_LOCAL_ASSET_CACHE_MODE="auto"
ROXY_LOCAL_ASSET_CACHE_DIR="./cache/roxy-assets"
ROXY_LOCAL_ASSET_CACHE_MAX_AGE="86400"
ROXY_LOCAL_ASSET_CACHE_MAX_ITEM_BYTES="26214400"
# Một tài khoản một profile: mỗi tài khoản buộc tạo Roxy Profile mới, dùng xong đóng và xoá, cấm tái dùng profile cố định
ROXY_ONE_PROFILE_PER_ACCOUNT="True"
# Xoá môi trường khi xong: ở chế độ một tài khoản một profile, xoá Roxy Profile vừa tạo sau tác vụ
ROXY_DELETE_PROFILE_AFTER_RUN="True"
# Tạo môi trường dùng kho proxy: khi tạo môi trường Roxy lấy ngẫu nhiên một proxy từ «Kho proxy», ghi vào Roxy proxyInfo
ROXY_CREATE_USE_PROXY_POOL="True"
# Kênh kiểm tra proxy: ghi vào Roxy proxyInfo.checkChannel; để trống thì không truyền, mặc định IPRust.io
ROXY_PROXY_CHECK_CHANNEL="IPRust.io"
# Path API xoá: mặc định /browser/delete; bản Roxy khác thì chỉnh
ROXY_DELETE_PATH="/browser/delete"

# ---- CPA / Codex ----
# Driver uỷ quyền Codex: protocol=uỷ quyền giao thức gốc; roxy=RoxyBrowser; cloak=CloakBrowser; browser_use=Browser Use Cloud; skyvern=Skyvern; same_as_registration=theo driver đăng ký
CODEX_OAUTH_DRIVER="roxy"

# ---- RoxyBrowser ----
# Timeout callback Codex: số giây tối đa Roxy Codex OAuth chờ callback localhost:1455
ROXY_CODEX_CALLBACK_TIMEOUT="180"

# ---- Công tắc tính năng ----
# Bật 2FA (TOTP): sau đăng ký tự đặt mã động (sẽ nhận thêm một email OTP)
ENABLE_2FA="True"
# Chế độ proxy 2FA: saved=ưu tiên proxy đã lưu của tài khoản; pool=mỗi lần rút ngẫu nhiên từ kho proxy
TWOFA_PROXY_MODE="saved"
# Số lần thử tối đa giai đoạn khởi tạo xác thực lại 2FA (thử lại khi 403/429/5xx/lỗi mạng)
TWOFA_REAUTH_MAX_ATTEMPTS=3
# Số giây chờ cơ bản khi thử lại xác thực lại 2FA (backoff mũ 1, 2, 4 lần)
TWOFA_REAUTH_RETRY_DELAY=4
# Số luồng đồng thời tác vụ nền 2FA (đổi xong cần restart dịch vụ)
TWOFA_WORKERS="4"
# Sức chứa hàng đợi chờ nền 2FA
TWOFA_QUEUE_LIMIT="200"
# Bật trigger Flow: sau đăng ký thành công tự gọi API Flow nội bộ (không ảnh hưởng kết quả đăng ký)
ENABLE_FLOW_TRIGGER="True"

# ---- Nhịp người ----
# Bật tạm dừng ngẫu nhiên: chờ ngẫu nhiên giữa các bước đăng ký, OTP, uỷ quyền, gần nhịp thao tác người hơn
ENABLE_HUMANIZE_DELAY="True"
# Hệ số tạm dừng: hệ số chung của chờ ngẫu nhiên; 1.0=mặc định, 0.5=một nửa, 2.0=gấp đôi
HUMANIZE_DELAY_FACTOR="1.0"

# ---- Email / OTP ----
# Tự lấy email + nhận mã: True=tự lấy email từ kho và tự nhận OTP; False=thủ công: dùng REGISTER_EMAIL, OTP điền tay trên trang tác vụ
USE_EMAIL_SERVICE="True"
# Email đăng ký thủ công: bắt buộc khi USE_EMAIL_SERVICE=False. Ví dụ địa chỉ outlook.com; xem OTP trên webmail rồi nộp lại trang tác vụ
REGISTER_EMAIL=""
# Tên hiển thị: để trống thì tự sinh tên tiếng Anh
REGISTER_NAME=""
# Chờ OTP tối đa (giây): số giây tối đa chờ email mã OTP, quá hạn coi thất bại
OTP_MAX_WAIT="90"
# Chu kỳ poll OTP (giây): bao nhiêu giây kiểm tra thư mới một lần
OTP_POLL_INTERVAL="3"
# Nguồn email: một hoặc nhiều, phân tách bằng dấu phẩy và fallback theo thứ tự: outlook,generic_api,cloudflare_domain,cloudflare,gptmail,mailnest,cloudmail,remail
EMAIL_SOURCE="generic_api"
# Chế độ lấy thư Outlook: auto=ưu tiên remote, remote 402/DEPLOYMENT_DISABLED thì chuyển Graph trực tiếp; direct=chỉ Microsoft Graph trực tiếp; remote=chỉ dịch vụ remote
OUTLOOK_FETCH_MODE=
# Chỉ cloudflare_domain: domain forward Email Routing, ví dụ mydomain.com (không liên quan EMAIL_SOURCE=cloudflare)
EMAIL_DOMAIN=
# Chỉ cloudflare_domain: email QQ nhận forward Email Routing, ví dụ 123456@qq.com
QQ_EMAIL=
# Chỉ cloudflare_domain: mã uỷ quyền IMAP email QQ (không ghi ngược config/*.py)
QQ_IMAP_PASSWORD=
# GPTMail API Key: bắt buộc khi EMAIL_SOURCE=gptmail; địa chỉ dịch vụ cố định https://mail.chatgpt.org.uk
GPTMAIL_API_KEY=

# Email tạm Cloudflare Worker (khi EMAIL_SOURCE chứa cloudflare; khác cloudflare_domain/QQ IMAP)
# Gốc API Worker, ví dụ https://mail.example.com (đừng thêm path thừa ở cuối)
CLOUDFLARE_API_BASE=
# Ẩn danh có thể để trống; chế độ admin điền ADMIN_PASSWORD
CLOUDFLARE_API_KEY=
# none / bearer / x-api-key / x-admin-auth / query-key; admin nên dùng x-admin-auth
CLOUDFLARE_AUTH_MODE=
# Mật khẩu toàn cục Worker, inject header x-custom-auth; không có thì để trống
CLOUDFLARE_CUSTOM_AUTH=
# Path tạo email: mặc định /api/new_address; admin thường dùng /admin/new_address
CLOUDFLARE_PATH_ACCOUNTS=
# Path danh sách thư: mặc định /api/mails
CLOUDFLARE_PATH_MESSAGES=
# Path danh sách domain: mặc định /api/domains
CLOUDFLARE_PATH_DOMAINS=
# Path Token: mặc định /api/token (fallback dự phòng)
CLOUDFLARE_PATH_TOKEN=
# Domain nhận thư mặc định, phân tách bằng dấu phẩy, ví dụ mail.example.com; để trống thì Worker quyết định
CLOUDFLARE_DEFAULT_DOMAINS=
# Timeout request HTTP (giây), mặc định 20
CLOUDFLARE_REQUEST_TIMEOUT=
# Độ dài local-part ngẫu nhiên khi admin tạo, mặc định 10
CLOUDFLARE_NAME_LENGTH=
# Trang lấy API key email tạm Outlook MailNest: https://mailnest.top/account
MAIL_NEST_API_KEY=
# Mã dự án MailNest: mặc định chatgpt001
MAIL_NEST_PROJECT_CODE=
# Địa chỉ CloudMail/Cloud Mail API, ví dụ https://mail.example.com
CLOUDMAIL_API_BASE=
# Email admin CloudMail; điền tài khoản/mật khẩu rồi lưu cấu hình sẽ tự lấy CLOUDMAIL_AUTH_TOKEN
CLOUDMAIL_ADMIN_EMAIL=
# Mật khẩu đăng nhập CloudMail
CLOUDMAIL_PASSWORD=
# Path API tạo Token CloudMail, mặc định /api/public/genToken
CLOUDMAIL_TOKEN_PATH=
# CloudMail/Cloud Mail API Authorization Token
CLOUDMAIL_AUTH_TOKEN=
# Danh sách domain email CloudMail, mỗi dòng một domain
CLOUDMAIL_DOMAINS=
# Sau khi sinh email ngẫu nhiên có tự gọi /api/public/addUser không
CLOUDMAIL_AUTO_ADD_USER=
# Độ dài local-part email ngẫu nhiên
CLOUDMAIL_RANDOM_LOCAL_LENGTH=
# Tài liệu Remail Open API: https://remail.aishop6.com/docs
# Gốc API; điền URL tài liệu cũng được, client tự bỏ /docs
REMAIL_API_BASE="https://remail.aishop6.com"
# API Key đầu rk- tạo ở console Remail
REMAIL_API_KEY=""
# projectId trong danh sách dự án Remail (dự án mã OTP ChatGPT/OpenAI)
REMAIL_PROJECT_ID="2"
# Hậu tố email khi đặt hàng, mặc định outlook.com
REMAIL_EMAIL_SUFFIX="icloud.com"
# code=nhận mã ngắn hạn; purchase=mua dài hạn (nhận thư lặp lại), mặc định purchase
REMAIL_SERVICE_MODE="purchase"
# private_first hoặc public_only, mặc định public_only
REMAIL_SUPPLY_POLICY="public_only"
# Số giây tối đa chờ service token đủ sau khi đặt hàng, mặc định 30
REMAIL_ORDER_WAIT_SECONDS="30"
# Timeout request HTTP (giây), mặc định 20
REMAIL_REQUEST_TIMEOUT="20"

# ---- Hồ sơ trình duyệt ----
# Hồ sơ vùng: nên khớp vùng IP đầu ra proxy; jp/cn/us/sg. Proxy local đo được là Tokyo, nên jp
BROWSER_LOCALE_PROFILE="jp"
# Tự chọn hồ sơ theo IP đầu ra: mỗi BrowserSession tự chọn ngôn ngữ/múi giờ theo IP đầu ra proxy; lỗi thì về hồ sơ vùng
AUTO_BROWSER_LOCALE_FROM_IP="True"
# Timeout định vị IP (giây): timeout mỗi request API địa lý IP đầu ra; API lỗi thì tự fallback, không ảnh hưởng đăng ký
IP_GEO_TIMEOUT="6.0"

# ---- Kho proxy ----
# Kho proxy (mỗi dòng một URL): dòng trống bị bỏ; trống hoàn toàn thì không dùng proxy
PROXY_POOL=""
# Chế độ mạng tra gói: auto=dùng proxy local nếu có, không lắng nghe thì đi thẳng; proxy=ép proxy; direct=ép đi thẳng
PLAN_CHECK_PROXY_MODE="auto"
# Proxy riêng tra gói: để trống thì auto/proxy chọn từ kho proxy; có thể chứa thông tin xác thực
PLAN_CHECK_PROXY=""
# Proxy upstream local cho tra gói: nối proxy động phía trên qua proxy local, thành chuỗi proxy
PLAN_CHECK_UPSTREAM_PROXY="http://127.0.0.1:7897"

# ---- CPA / Codex ----
# Nguồn URL uỷ quyền: cpa=CPA management API tạo URL; local=bản cũ tự sinh URL PKCE local
CODEX_AUTH_URL_SOURCE="local"
# Địa chỉ quản trị CPA: ví dụ http://localhost:8317/admin/oauth; chương trình lấy origin rồi gọi /v0/management/*
CPA_MANAGEMENT_URL=
# Khoá quản trị: lưu trong .env (CPA_MANAGEMENT_KEY), không ghi ngược config/*.py
CPA_MANAGEMENT_KEY=
# Timeout CPA (giây): timeout request CPA management API
CPA_REQUEST_TIMEOUT=
# Lưu biên nhận CPA: nếu CPA không trả file uỷ quyền đầy đủ, local vẫn lưu bản ghi đã nộp callback
CPA_SAVE_CALLBACK_RECEIPT=

# ---- Nền tảng nhận OTP SMS ----
# Kênh nhận OTP SMS: grizzly / l / h; h dùng dịch vụ lấy số local trong H_API.md
SMS_PROVIDER="smsbower"
# Mã quốc gia: country gửi nền tảng nhận OTP; GrizzlySMS thường Mỹ=187; kênh L/H điền theo admin local
SMS_COUNTRY="187"
# Mã dịch vụ/dự án: GrizzlySMS/L dùng làm service; kênh H có thể tái dùng làm projectId
SMS_SERVICE="dr"
# Số lần đổi số: một số không nhận SMS hoặc OpenAI từ chối thì đổi số, tối đa bao nhiêu lần
SMS_MAX_RETRIES="10"
# Chờ SMS một số (giây): số giây tối đa một số chờ SMS, quá hạn thì đổi số
SMS_CODE_WAIT="120"
# Khoá API GrizzlySMS: lưu trong .env (SMS_API_KEY), không ghi ngược config/*.py
SMS_API_KEY=
# Địa chỉ H API: gốc dịch vụ lấy số H, ví dụ http://localhost:8788
H_API_BASE=
# Mã uỷ quyền H: lưu trong .env (H_ADMIN_AUTH_CODE), không ghi ngược config/*.py
H_ADMIN_AUTH_CODE=
# Tiền tố số H: điền khi số H không có mã quốc gia, ví dụ số local Mỹ 10 số điền 1; để trống thì không thêm
H_PHONE_PREFIX=
# Cách lấy số H: reusable=ưu tiên tái dùng số; new=mỗi lần lấy số mới (gọi /api/admin/h/take-phone)
H_PHONE_ACQUIRE_MODE=
# Địa chỉ L API: gốc dịch vụ lấy số L, ví dụ http://localhost:8788
L_API_BASE=
# Mã uỷ quyền L: lưu trong .env (L_ADMIN_AUTH_CODE), không ghi ngược config/*.py
L_ADMIN_AUTH_CODE=
# Tiền tố số L: điền khi số L không có mã quốc gia, ví dụ số local Mỹ 10 số điền 1; để trống thì không thêm
L_PHONE_PREFIX=

# ---- updated by WebUI / config.env_loader ----
AUTO_PLAN_CHECK_AFTER_REGISTER="False"
BROWSER_USE_SESSION_TIMEOUT="240"
ROXY_RANDOM_OS_ON_CREATE="True"
ROXY_RANDOM_PROFILE_NAME_ON_CREATE="True"
ROXY_RANDOM_OS_CHOICES="Windows,macOS"
ROXY_PROFILE_NAME_PREFIX="rb"
ENABLE_HUMANIZE_BROWSER_ACTIONS="True"
PLAN_CHECK_TIMEOUT="15.0"
PLAN_CHECK_MAX_ATTEMPTS="2"
PLAN_CHECK_RETRY_DELAY="1.5"
PLAN_CHECK_REGISTRATION_RECHECK_DELAY="2.0"
PLAN_CHECK_WORKERS="3"
PLAN_CHECK_QUEUE_LIMIT="500"
PLAN_CHECK_MIN_INTERVAL="0.4"
PLAN_CHECK_JITTER="0.3"
EXTRACT_LINK_API_BASE=""
EXTRACT_LINK_CDK=""
EXTRACT_LINK_TYPE="pix"
